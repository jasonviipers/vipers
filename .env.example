# ═══════════════════════════════════════════════════════════════════════════
# Viipers — environment template
#
# Copy to `.env` and fill in values for your environment. Groups are ordered
# by how soon you need them (core first, integrations later). Every optional
# group says what breaks / degrades when it's absent — nothing silently fails.
# ═══════════════════════════════════════════════════════════════════════════

# ── Core (required) ─────────────────────────────────────────────────────────
# Primary Postgres connection string (Neon or local), all trading/financial data.
DATABASE_URL=

# Session/API-key plumbing (all three are required by src/env.ts).
# Pattern the operator key must match, e.g. vps_[A-Za-z0-9_]{16,}
API_KEY_PATTERN=
# A real operator key matching API_KEY_PATTERN (grants full write access).
API_KEY_VALID=
# Demo key (read-only identity; "Try Demo" on the login screen).
DEMO_API_KEY=

# ── Client-exposed (NEXT_PUBLIC_, no secrets here) ──────────────────────────
# Publishable auth key (client-side bootstrap only).
NEXT_PUBLIC_PUBLISHABLE_KEY=
# Key prefix shown to the user so they know which format to paste.
NEXT_PUBLIC_API_KEY_PREFIX=

# ── Encryption & sessions (required in production; dev derives a fallback) ──
# base64 of exactly 32 bytes, e.g. `openssl rand -base64 32`. Encrypts broker/LLM keys.
SECRET_BOX_KEY=
# HMAC-SHA256 signing key for the signed session cookie.
SESSION_SECRET=

# ── LLM providers (bootstrap fallback; the /settings UI store overrides env) ─
# Setting a key here is optional if the provider's key row exists in /settings.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
# Ollama Cloud (https://ollama.com/settings/keys). Powers the OLLAMA provider
# in the fleet's per-agent model picker; without it OLLAMA falls back to the
# next configured provider like any other keyless provider.
OLLAMA_API_KEY=

# ── Per-agent headless keys (optional) ──────────────────────────────────────
# JSON map of agent-id → its own vps_ key, e.g. {"sentiment-agent":"vps_..."}.
# Lets fleet members call HTTP endpoints with individual credentials.
AGENT_API_KEYS=

# ── Market/sentiment integrations (all optional; tools degrade honestly) ────
# Twitter/X API v2 Bearer token. X_API_BEARER_TOKEN is canonical; the legacy
# TWITTER_BEARER_TOKEN is kept as an alias. Without one, the tool returns
# unconfigured:true rather than inventing tweets.
X_API_BEARER_TOKEN=
TWITTER_BEARER_TOKEN=

# Reddit app-only OAuth ("script" app from reddit.com/prefs/apps). When both
# are set, fetches authenticate against oauth.reddit.com, bypassing the public
# .json 403 network blocks. Without them, public endpoints + honest block status.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# StockTwits Whisperer API key (https://stocktwitsapi.com). Without it, the
# SENTIMENT tool degrades to a labeled dev fallback (prod: throws).
STOCKTWITS_API_KEY=

# ── Composio (optional) ─────────────────────────────────────────────────────
# Platform project key from dashboard.composio.dev → Platform → project →
# Getting Started. Enables the /channels integration page (operator connects
# Reddit / Discord / Telegram / Twitter once) and the Composio-backed Reddit
# fetch in src/lib/composio.ts. Without it, /channels reports unconfigured
# and market-signals degrades to the RSS source — never inventing posts.
COMPOSIO_API_KEY=

# ── Infrastructure (optional) ───────────────────────────────────────────────
# Second Postgres DB for the durable scraper store (scraped messages + cache
# from the Reddit/news/Twitter/StockTwits tools). Without it, scraper tools
# keep working with in-process caches only and skip the write-through.
SCRAPER_DATABASE_URL=

# Redis (Upstash rediss:// or any Redis URL). Without it, caches fall back to
# in-process memory. Session revocation degrades to fail-open without it.
REDIS_URL=

# Paper-book starting notional (USD). Without it, paper execution is disabled.
PAPER_BOOK_NOTIONAL_USD=
